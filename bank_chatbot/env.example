# Application Settings
DEBUG=False

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# PostgreSQL Configuration (Local Docker Container)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatbot_db
POSTGRES_USER=chatbot_user
POSTGRES_PASSWORD=chatbot_password_123

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600

# LightRAG Configuration (base URL without /query - the client appends it)
LIGHTRAG_URL=http://localhost:9262/query
LIGHTRAG_API_KEY=MyCustomLightRagKey456
LIGHTRAG_KNOWLEDGE_BASE=default
LIGHTRAG_TIMEOUT=30
ENABLE_LIGHTRAG_RERANK=False
LIGHTRAG_TOP_K=8
LIGHTRAG_CHUNK_TOP_K=10
LIGHTRAG_POLICY_TOP_K=15
LIGHTRAG_POLICY_CHUNK_TOP_K=20
MIN_GROUNDING_CONTEXT_CHARS=100

# Card Rates Microservice
CARD_RATES_URL=http://localhost:8002

# Chat Settings
MAX_CONVERSATION_HISTORY=10
ENABLE_STREAMING=True

# Secure per-user chat history
# How many recent messages are loaded per authenticated user and fed to the LLM.
CHAT_HISTORY_CONTEXT_LIMIT=20
# Redact OTPs/passwords/PINs/CVVs/card & account numbers before storing (keep True).
CHAT_HISTORY_REDACTION_ENABLED=True
# Optional encryption-at-rest for stored message text. Leave empty for plaintext.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAT_HISTORY_ENCRYPTION_KEY=

# Lead Generation (disabled by default - set to True to enable)
ENABLE_LEAD_GENERATION=True

# CORS (comma-separated list of origins, or * for all)
# Production HTTPS: https://dia.ebl-bd.com
CORS_ORIGINS=https://dia.ebl-bd.com,http://localhost:3000

# Public hostname (for documentation / gateway)
PUBLIC_HOST=dia.ebl-bd.com

# TLS gateway host ports (production: 80 and 443; Windows dev often needs 8080/8443)
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# LDAP/Active Directory Configuration (Phonebook Sync + Employee Login)
LDAP_SERVER=192.168.5.60
LDAP_PORT=389
LDAP_BASE_DN=DC=ebl,DC=local
LDAP_BIND_USER=EBL\service_account
LDAP_BIND_PASSWORD=your_ldap_password
LDAP_USE_SSL=False
LDAP_DOMAIN=ebl.bd
LDAP_NETBIOS_DOMAIN=EBL
LDAP_EMAIL_DOMAIN=@ebl-bd.com
LDAP_CONNECT_TIMEOUT=10
# Optional: domain-wide AD search for login names (defaults to DC=ebl,DC=bd from LDAP_DOMAIN)
LDAP_AUTH_SEARCH_BASE=DC=ebl,DC=bd
# Sales agent AD provisioning (Lead Portal admin UI)
LDAP_USERS_OU=OU=Sales Agents,OU=Users,DC=ebl,DC=bd
LDAP_DEFAULT_USER_PASSWORD=Ebl123
LDAP_PROVISION_ENABLED=False

# Employee authentication (Active Directory login for chatbot UI)
AUTH_ENABLED=True
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Dashboard analytics (sent as X-Analytics-Key header; required when AUTH_ENABLED=True)
ANALYTICS_API_KEY=change-this-analytics-key-in-production
JWT_EXPIRE_MINUTES=480

# EBL Home intranet forms (metadata index + download links only)
ENABLE_EBLHOME_FORMS=True
ENABLE_EBLHOME_APPS=True
ENABLE_EBLHOME_LEADERSHIP=True
ENABLE_EBLHOME_SOC=True
ENABLE_EBLHOME_PROPOSALS=True
ENABLE_EBLHOME_CIRCULARS=True
EBLHOME_BASE_URL=http://eblhome
EBLHOME_MYSQL_HOST=192.168.3.57
EBLHOME_MYSQL_PORT=3306
EBLHOME_MYSQL_DB=ebl_home
EBLHOME_MYSQL_USER=tanvir
EBLHOME_MYSQL_PASSWORD=your_mysql_password_here
PUBLIC_API_BASE_URL=https://dia.ebl-bd.com/api
# Optional: if chatbot server cannot reach http://eblhome directly
# EBLHOME_FETCH_BASE_URL=http://192.168.3.57

# Semantic intent router (local ONNX embeddings on CPU; no LLM/GPU required).
# Off by default. Set to True and MODE=shadow to log routing comparisons
# without changing behaviour; MODE=active to route with it (regex fallback).
ENABLE_SEMANTIC_ROUTER=False
SEMANTIC_ROUTER_MODE=shadow
SEMANTIC_ROUTER_THRESHOLD=0.62
SEMANTIC_ROUTER_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_CACHE_DIR=/app/.fastembed_cache

